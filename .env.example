# Senha do painel de leads em /admin (obrigatória em produção)
ADMIN_USER=jaqueline
ADMIN_PASS=troque-esta-senha

# Preenchida automaticamente pelo Railway ao adicionar o Postgres.
# Sem ela, os leads são gravados em data/leads.json (só para rodar local).
DATABASE_URL=

# Opcional: porta local
PORT=3000

# --- Captura "Semana Rumo à SEEDF" (/srs) e /dash ---
# Endereço do App da Web do Apps Script (Implantar → termina em /exec)
APPS_SCRIPT_URL=
# A mesma senha gravada na propriedade CHAVE do Apps Script
APPS_SCRIPT_CHAVE=
# Login do /dash (se ficar vazio, usa ADMIN_USER/ADMIN_PASS)
DASH_USER=
DASH_PASS=
